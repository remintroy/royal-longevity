# WhatsApp contact configuration is maintained in data/contact.ts (WHATSAPP_NUMBER).

# PostHog project token (public, not a personal API key). Leave empty to disable.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Use the ingestion host from your PostHog project settings:
# US: https://us.i.posthog.com | EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# CMS (content admin at /admin). Use a MongoDB Atlas connection string.
MONGODB_URI=
MONGODB_DB=royal-longevity
# Password for /admin and an optional separate secret for signing the session cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
